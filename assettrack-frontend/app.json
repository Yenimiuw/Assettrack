{
  "expo": {
    "name": "AssetTrack",
    "slug": "assettrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "https://assettrack-assettrack-api.vercel.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.assettrack",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AssetTrack to use the camera to scan QR codes on items.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "b3760a90-72b5-494e-a9ab-323e7746c485"
      }
    }
  }
}
